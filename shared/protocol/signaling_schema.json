{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TeleLensSignalingMessage",
  "type": "object",
  "required": ["type", "payload"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["hello", "hello_ack", "offer", "answer", "candidate", "reject", "disconnect"]
    },
    "sessionId": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  }
}
